# WorkReady Simulation — API configuration
#
# This file configures the WorkReady API (FastAPI backend).
# Copy to .env and fill in values before starting.

# --- LLM Provider ---
# Options: stub (no API key needed), ollama, anthropic, openrouter
LLM_PROVIDER=stub

# Model name (interpreted by the chosen provider)
LLM_MODEL=llama3.2

# Ollama (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenRouter (if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# --- Database ---
# SQLite path — the Docker volume mounts ./data to /opt/workready/data
WORKREADY_DB=/opt/workready/data/workready.db

# --- Admin / debug ---
# Set a token to enable the admin endpoints. Leave blank to disable.
# Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
WORKREADY_ADMIN_TOKEN=

# --- Interview booking (optional tuning) ---
INTERVIEW_BOOKING_ENABLED=false
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
TIMEZONE=Australia/Perth
RESUME_FEEDBACK_DELAY_MINUTES=0
INTERVIEW_INVITATION_DELAY_MINUTES=0
