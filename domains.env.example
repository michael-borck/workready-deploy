# WorkReady Simulation — domain configuration
#
# Each service needs its own domain. Point all 9 DNS A/CNAME records
# at the IP of the machine running WorkReady, then fill in the domains
# below. Caddy will handle routing and (if port 443 is open) automatic
# TLS via Let's Encrypt.
#
# For local testing without DNS, leave these commented out — Caddy will
# fall back to *.localhost domains on port 80.

# --- Company sites ---
DOMAIN_IRONVALE=ironvaleresources.eduserver.au
DOMAIN_NEXUSPOINT=nexuspointsystems.eduserver.au
DOMAIN_HORIZON=horizonfoundation.eduserver.au
DOMAIN_SOUTHERN_CROSS=southerncrossfinancial.eduserver.au
DOMAIN_METRO=metrocouncilwa.eduserver.au
DOMAIN_MERIDIAN=meridianadvisory.eduserver.au

# --- Platform ---
DOMAIN_PORTAL=workready.eduserver.au
DOMAIN_SEEK=seekjobs.eduserver.au
DOMAIN_API=workready-api.eduserver.au
